# Kontaktformular (app/api/contact/route.ts)
# Ohne diese Variablen zeigt das Formular einen freundlichen Hinweis an,
# per Telefon/E-Mail direkt Kontakt aufzunehmen, statt eine Nachricht
# stillschweigend zu verlieren.
#
# 1. Konto auf https://resend.com anlegen (oder anderen Transaktions-E-Mail-Dienst)
# 2. Absender-Domain (z.B. lerncoaching-engeli.ch) bei Resend verifizieren
# 3. API-Key erstellen und hier eintragen
RESEND_API_KEY=
# Absenderadresse, muss zur verifizierten Domain gehören
CONTACT_FROM_EMAIL="Lerncoaching Engeli <kontakt@lerncoaching-engeli.ch>"
# Empfängeradresse für Anfragen (Default: seraina@lerncoaching-engeli.ch)
CONTACT_TO_EMAIL=seraina@lerncoaching-engeli.ch
